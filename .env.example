# ==========================================

# Application Configuration

# ==========================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/skripsi

# ==========================================

# Database Configuration

# ==========================================

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=totp
DB_USERNAME=root
DB_PASSWORD=

# ==========================================

# Authentication / TOTP

# ==========================================

# Generate a unique secret for your environment.

# Do NOT put real TOTP secrets in this file.

TOTP_ISSUER=Sistem Pengamanan Dokumen

# ==========================================

# Security

# ==========================================

# Generate a strong random secret for production.

APP_KEY=
SESSION_SECRET=

# ==========================================

# Email Configuration

# ==========================================

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sistem Pengamanan Dokumen"
